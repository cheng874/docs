#: ../../../flagos_homepage/chip_adaptation_guide/_shared/05_compatibility_certification/certification_maintenance.md:2
msgid "Certification Maintenance"
msgstr ""

#: ../../../flagos_homepage/chip_adaptation_guide/_shared/05_compatibility_certification/certification_maintenance.md:4
msgid "Validity period: 12 months; recertification is required at expiration."
msgstr ""

#: ../../../flagos_homepage/chip_adaptation_guide/_shared/05_compatibility_certification/certification_maintenance.md:6
msgid ""
"Changes triggering retesting: major driver upgrades, Triton backend "
"refactoring, or major PyTorch upgrades."
msgstr ""

#: ../../../flagos_homepage/chip_adaptation_guide/_shared/05_compatibility_certification/certification_maintenance.md:8
#, python-format
msgid ""
"Certification revocation: a CI pass rate below 80% for three consecutive "
"months, or an unresolved critical security vulnerability."
msgstr ""

#: ../../../flagos_homepage/chip_adaptation_guide/_shared/05_compatibility_certification/certification_maintenance.md:10
msgid ""
"Waiver management: each waiver must state the technical reason, "
"remediation plan, and expected remediation date; the maximum waiver "
"period is six months."
msgstr ""

